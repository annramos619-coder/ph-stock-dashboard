{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/quotes",   "destination": "/api/quotes"   },
    { "source": "/api/news",     "destination": "/api/news"     },
    { "source": "/api/analysis",    "destination": "/api/analysis"    },
    { "source": "/api/disclosures", "destination": "/api/disclosures" },
    { "source": "/api/crypto",         "destination": "/api/crypto"         },
    { "source": "/api/crypto-detail",  "destination": "/api/crypto-detail"  },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
